+// gameOS: CartROM can be an mmap of the ROM file instead of a heap buffer
+// (see LoadROM below), so freeing has to know which one it is.
+static bool CartROMMapped = false;
+
+static void FreeCartROM()
+{
+    if (!CartROM) return;
+#ifndef _WIN32
+    if (CartROMMapped)
+    {
+        munmap(CartROM, CartROMSize);
+        CartROMMapped = false;
+        CartROM = nullptr;
+        return;
+    }
+#endif
+    delete[] CartROM;
+    CartROM = nullptr;
+}
