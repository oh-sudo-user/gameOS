--- a/gfx/drivers_context/drm_ctx.c
+++ b/gfx/drivers_context/drm_ctx.c
@@ -115,6 +115,518 @@
 static drmModeModeInfo gfx_ctx_crt_switch_mode;
 static bool switch_mode                   = false;
 
+/* ===========================================================================
+ * gameOS dual-screen support (Anbernic RG DS / RG DS Plus, RK3568 VOP2)
+ *
+ * Enabled with GAMEOS_DUALSCREEN=1. Creates one span GBM framebuffer
+ * (1024x1536 on Plus, 640x960 on DS) and scans it out across both DSI
+ * panels with a single atomic commit: top panel shows FB rows [0,top_h),
+ * bottom panel shows rows [top_h,span_h). DSI-2 is the physical top (lid)
+ * panel on both models. The melonDS libretro core in vertical layout
+ * (256x384) then scales integer onto both physical screens, with touch on
+ * the bottom panel mapped to the bottom NDS screen (udev_input.c patch).
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * =========================================================================== */
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <time.h>
+
+static bool g_gameos_dual               = false;
+static drmModeModeInfo g_gameos_span_mode;
+static drmModeModeInfo g_gameos_mode_top;
+static drmModeModeInfo g_gameos_mode_bot;
+static uint32_t g_gameos_crtc_top       = 0;
+static uint32_t g_gameos_crtc_bot       = 0;
+static uint32_t g_gameos_plane_top      = 0;
+static uint32_t g_gameos_plane_bot      = 0;
+static uint32_t g_gameos_blob_top       = 0;
+static uint32_t g_gameos_blob_bot       = 0;
+static uint32_t g_gameos_top_h          = 0;
+static uint32_t g_gameos_span_w         = 0;
+static uint32_t g_gameos_conn_top       = 0;
+static uint32_t g_gameos_conn_bot       = 0;
+
+typedef struct
+{
+   uint32_t fb_id, crtc_id;
+   uint32_t src_x, src_y, src_w, src_h;
+   uint32_t crtc_x, crtc_y, crtc_w, crtc_h;
+} gameos_plane_props_t;
+
+static gameos_plane_props_t g_gp_top, g_gp_bot;
+static uint32_t g_gc_mode_top, g_gc_active_top;
+static uint32_t g_gc_mode_bot, g_gc_active_bot;
+static uint32_t g_gc_conn_top, g_gc_conn_bot;
+static int g_gameos_flip_errors = 0;
+
+/* Field diagnostics: RetroArch's own log died with the power cut on the
+ * handheld, so dual-screen decisions are also fsynced to the data partition. */
+static void gameos_dlog(const char *fmt, ...)
+{
+   char msg[512];
+   char line[600];
+   va_list ap;
+   time_t now;
+   struct tm tmv;
+   FILE *f;
+
+   va_start(ap, fmt);
+   vsnprintf(msg, sizeof(msg), fmt, ap);
+   va_end(ap);
+
+   now = time(NULL);
+   localtime_r(&now, &tmv);
+   snprintf(line, sizeof(line), "[%02d:%02d:%02d] %s\n",
+         tmv.tm_hour, tmv.tm_min, tmv.tm_sec, msg);
+
+   f = fopen("/userdata/system/dual.log", "a");
+   if (!f)
+      f = fopen("/tmp/dual.log", "a");
+   if (!f)
+      return;
+   fputs(line, f);
+   fflush(f);
+   fsync(fileno(f));
+   fclose(f);
+}
+
+static uint32_t gameos_prop_id(int fd, uint32_t obj_id,
+      uint32_t obj_type, const char *name)
+{
+   uint32_t id = 0;
+   drmModeObjectProperties *props =
+      drmModeObjectGetProperties(fd, obj_id, obj_type);
+   if (!props)
+      return 0;
+   for (uint32_t i = 0; i < props->count_props; i++)
+   {
+      drmModePropertyRes *p = drmModeGetProperty(fd, props->props[i]);
+      if (p)
+      {
+         if (strcmp(p->name, name) == 0)
+            id = p->prop_id;
+         drmModeFreeProperty(p);
+         if (id)
+            break;
+      }
+   }
+   drmModeFreeObjectProperties(props);
+   return id;
+}
+
+static bool gameos_cache_plane_props(int fd, uint32_t plane,
+      gameos_plane_props_t *pp)
+{
+   pp->fb_id   = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "FB_ID");
+   pp->crtc_id = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "CRTC_ID");
+   pp->src_x   = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "SRC_X");
+   pp->src_y   = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "SRC_Y");
+   pp->src_w   = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "SRC_W");
+   pp->src_h   = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "SRC_H");
+   pp->crtc_x  = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "CRTC_X");
+   pp->crtc_y  = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "CRTC_Y");
+   pp->crtc_w  = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "CRTC_W");
+   pp->crtc_h  = gameos_prop_id(fd, plane, DRM_MODE_OBJECT_PLANE, "CRTC_H");
+
+   /* Every atomic property must resolve to a real id; a zero id would make
+    * drmModeAtomicAddProperty target object/property 0 and silently corrupt
+    * the request. Fail init so we fall back to single-panel mode. */
+   if (!pp->fb_id || !pp->crtc_id ||
+       !pp->src_x || !pp->src_y || !pp->src_w || !pp->src_h ||
+       !pp->crtc_x || !pp->crtc_y || !pp->crtc_w || !pp->crtc_h)
+   {
+      RARCH_ERR("[KMS] gameOS: plane %u missing atomic properties.\n", plane);
+      return false;
+   }
+   return true;
+}
+
+/* Add one atomic property, refusing a zero prop id and reporting a failed
+ * drmModeAtomicAddProperty. Returns false so the caller can abort the whole
+ * modeset instead of committing a half-built request. */
+static bool gameos_add_prop(drmModeAtomicReq *req, uint32_t obj,
+      uint32_t prop, uint64_t value)
+{
+   if (!prop)
+   {
+      RARCH_ERR("[KMS] gameOS: refusing atomic add with zero prop id "
+            "(obj %u).\n", obj);
+      return false;
+   }
+   if (drmModeAtomicAddProperty(req, obj, prop, value) < 0)
+   {
+      RARCH_ERR("[KMS] gameOS: drmModeAtomicAddProperty failed "
+            "(obj %u, prop %u).\n", obj, prop);
+      return false;
+   }
+   return true;
+}
+
+static uint32_t gameos_primary_plane(int fd, uint32_t crtc_id,
+      uint32_t exclude)
+{
+   uint32_t found = 0;
+   drmModeRes *res = drmModeGetResources(fd);
+   if (!res)
+      return 0;
+   int crtc_idx = -1;
+   for (int i = 0; i < res->count_crtcs; i++)
+      if (res->crtcs[i] == crtc_id)
+      {
+         crtc_idx = i;
+         break;
+      }
+   if (crtc_idx < 0)
+   {
+      drmModeFreeResources(res);
+      return 0;
+   }
+
+   drmModePlaneRes *pres = drmModeGetPlaneResources(fd);
+   if (!pres)
+   {
+      drmModeFreeResources(res);
+      return 0;
+   }
+   for (uint32_t i = 0; i < pres->count_planes && !found; i++)
+   {
+      drmModePlane *pl = drmModeGetPlane(fd, pres->planes[i]);
+      if (!pl)
+         continue;
+      if (pl->plane_id != exclude &&
+          (pl->possible_crtcs & (1u << crtc_idx)))
+      {
+         uint32_t type_prop = gameos_prop_id(fd, pl->plane_id,
+               DRM_MODE_OBJECT_PLANE, "type");
+         if (type_prop)
+         {
+            drmModeObjectProperties *props = drmModeObjectGetProperties(
+                  fd, pl->plane_id, DRM_MODE_OBJECT_PLANE);
+            if (props)
+            {
+               for (uint32_t j = 0; j < props->count_props; j++)
+                  if (props->props[j] == type_prop &&
+                      props->prop_values[j] == DRM_PLANE_TYPE_PRIMARY)
+                     found = pl->plane_id;
+               drmModeFreeObjectProperties(props);
+            }
+         }
+      }
+      drmModeFreePlane(pl);
+   }
+   drmModeFreePlaneResources(pres);
+   drmModeFreeResources(res);
+   return found;
+}
+
+static bool gameos_dual_init(int fd)
+{
+   drmModeRes *res = NULL;
+
+   gameos_dlog("init: begin primary connector=%u crtc=%u",
+         g_connector_id, g_crtc_id);
+
+   /* The atomic plane/CRTC API is gated per DRM file: without these caps the
+    * kernel rejects every drmModeAtomicCommit with EINVAL and the dual-screen
+    * modeset can never engage. */
+   if (drmSetClientCap(fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1) < 0)
+      gameos_dlog("init: universal-planes cap failed: %s",
+            strerror(errno));
+   if (drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) < 0)
+   {
+      gameos_dlog("init: atomic cap failed: %s", strerror(errno));
+      return false;
+   }
+   gameos_dlog("init: atomic client cap enabled");
+
+   res = drmModeGetResources(fd);
+   if (!res)
+   {
+      gameos_dlog("init: no DRM resources");
+      return false;
+   }
+
+   drmModeConnector *bot = NULL;
+   for (int i = 0; i < res->count_connectors; i++)
+   {
+      drmModeConnector *c = drmModeGetConnector(fd, res->connectors[i]);
+      if (!c)
+         continue;
+      gameos_dlog("conn %u type=%u.%u conn=%d modes=%d enc=%u",
+            c->connector_id, c->connector_type, c->connector_type_id,
+            c->connection, c->count_modes, c->encoder_id);
+      if (c->connector_id != g_connector_id &&
+          c->connection == DRM_MODE_CONNECTED && c->count_modes > 0)
+      {
+         bot = c;
+         break;
+      }
+      drmModeFreeConnector(c);
+   }
+   if (!bot)
+   {
+      gameos_dlog("init: no second connected connector");
+      drmModeFreeResources(res);
+      return false;
+   }
+
+   uint32_t crtc_bot = 0;
+   drmModeEncoder *enc = NULL;
+   if (bot->encoder_id)
+      enc = drmModeGetEncoder(fd, bot->encoder_id);
+   if (enc && enc->crtc_id && enc->crtc_id != g_crtc_id)
+      crtc_bot = enc->crtc_id;
+   if (!crtc_bot)
+   {
+      for (int e = 0; e < bot->count_encoders && !crtc_bot; e++)
+      {
+         drmModeEncoder *en = drmModeGetEncoder(fd, bot->encoders[e]);
+         if (!en)
+            continue;
+         for (int c = 0; c < res->count_crtcs; c++)
+            if ((en->possible_crtcs & (1u << c)) &&
+                res->crtcs[c] != g_crtc_id)
+            {
+               crtc_bot = res->crtcs[c];
+               break;
+            }
+         drmModeFreeEncoder(en);
+      }
+   }
+   if (enc)
+      drmModeFreeEncoder(enc);
+   if (!crtc_bot)
+   {
+      gameos_dlog("init: no CRTC for the bottom connector");
+      goto fail;
+   }
+
+   /* DSI-2 is the physical top (lid) panel on both RG DS models; the DRM
+    * primary may still be DSI-1, so swap the roles when it is. */
+   bool prim_is_top = !(g_drm_connector->connector_type ==
+         DRM_MODE_CONNECTOR_DSI && g_drm_connector->connector_type_id == 1);
+   drmModeConnector *topc = prim_is_top ? g_drm_connector : bot;
+   drmModeConnector *botc = prim_is_top ? bot : g_drm_connector;
+   g_gameos_crtc_top = prim_is_top ? g_crtc_id : crtc_bot;
+   g_gameos_crtc_bot = prim_is_top ? crtc_bot : g_crtc_id;
+   g_gameos_conn_top = topc->connector_id;
+   g_gameos_conn_bot = botc->connector_id;
+   g_gameos_mode_top = topc->modes[0];
+   g_gameos_mode_bot = botc->modes[0];
+   g_gameos_top_h    = g_gameos_mode_top.vdisplay;
+   g_gameos_span_w   = g_gameos_mode_top.hdisplay;
+   gameos_dlog("init: top conn=%u crtc=%u %ux%u, bottom conn=%u crtc=%u "
+         "%ux%u, span=%ux%u", g_gameos_conn_top, g_gameos_crtc_top,
+         g_gameos_mode_top.hdisplay, g_gameos_mode_top.vdisplay,
+         g_gameos_conn_bot, g_gameos_crtc_bot,
+         g_gameos_mode_bot.hdisplay, g_gameos_mode_bot.vdisplay,
+         g_gameos_span_w, g_gameos_span_mode.vdisplay);
+
+   g_gameos_span_mode          = g_gameos_mode_top;
+   g_gameos_span_mode.vdisplay = g_gameos_mode_top.vdisplay +
+                                 g_gameos_mode_bot.vdisplay;
+   g_gameos_span_mode.vtotal   = g_gameos_mode_top.vtotal +
+                                 g_gameos_mode_bot.vtotal;
+   snprintf(g_gameos_span_mode.name, DRM_DISPLAY_MODE_LEN, "gameos-span");
+
+   g_gameos_plane_top = gameos_primary_plane(fd, g_gameos_crtc_top, 0);
+   g_gameos_plane_bot = gameos_primary_plane(fd, g_gameos_crtc_bot,
+         g_gameos_plane_top);
+   gameos_dlog("init: planes top=%u bottom=%u",
+         g_gameos_plane_top, g_gameos_plane_bot);
+   if (!g_gameos_plane_top || !g_gameos_plane_bot ||
+       g_gameos_plane_top == g_gameos_plane_bot)
+   {
+      gameos_dlog("init: no distinct primary planes");
+      goto fail;
+   }
+
+   if (!gameos_cache_plane_props(fd, g_gameos_plane_top, &g_gp_top) ||
+       !gameos_cache_plane_props(fd, g_gameos_plane_bot, &g_gp_bot))
+   {
+      gameos_dlog("init: plane atomic properties missing");
+      goto fail;
+   }
+   g_gc_mode_top   = gameos_prop_id(fd, g_gameos_crtc_top,
+         DRM_MODE_OBJECT_CRTC, "MODE_ID");
+   g_gc_active_top = gameos_prop_id(fd, g_gameos_crtc_top,
+         DRM_MODE_OBJECT_CRTC, "ACTIVE");
+   g_gc_mode_bot   = gameos_prop_id(fd, g_gameos_crtc_bot,
+         DRM_MODE_OBJECT_CRTC, "MODE_ID");
+   g_gc_active_bot = gameos_prop_id(fd, g_gameos_crtc_bot,
+         DRM_MODE_OBJECT_CRTC, "ACTIVE");
+   if (!g_gc_mode_top || !g_gc_active_top ||
+       !g_gc_mode_bot || !g_gc_active_bot)
+   {
+      gameos_dlog("init: CRTC MODE_ID/ACTIVE properties missing");
+      goto fail;
+   }
+
+   /* Connector CRTC_ID binding: without this the atomic modeset activates
+    * the CRTCs and planes but leaves both connectors routed to nothing, so
+    * both panels stay black. Resolve and validate the prop ids up front. */
+   g_gc_conn_top = gameos_prop_id(fd, g_gameos_conn_top,
+         DRM_MODE_OBJECT_CONNECTOR, "CRTC_ID");
+   g_gc_conn_bot = gameos_prop_id(fd, g_gameos_conn_bot,
+         DRM_MODE_OBJECT_CONNECTOR, "CRTC_ID");
+   if (!g_gc_conn_top || !g_gc_conn_bot)
+   {
+      RARCH_ERR("[KMS] gameOS: connector CRTC_ID property unavailable.\n");
+      gameos_dlog("init: connector CRTC_ID property missing");
+      goto fail;
+   }
+
+   if (drmModeCreatePropertyBlob(fd, &g_gameos_mode_top,
+         sizeof(g_gameos_mode_top), &g_gameos_blob_top) < 0)
+   {
+      gameos_dlog("init: top mode blob failed: %s", strerror(errno));
+      goto fail;
+   }
+   if (drmModeCreatePropertyBlob(fd, &g_gameos_mode_bot,
+         sizeof(g_gameos_mode_bot), &g_gameos_blob_bot) < 0)
+   {
+      gameos_dlog("init: bottom mode blob failed: %s", strerror(errno));
+      goto fail;
+   }
+
+   RARCH_LOG("[KMS] gameOS dual-screen: %ux%u spanning two panels "
+         "(crtc %u/%u, plane %u/%u).\n",
+         g_gameos_span_w, g_gameos_span_mode.vdisplay,
+         g_gameos_crtc_top, g_gameos_crtc_bot,
+         g_gameos_plane_top, g_gameos_plane_bot);
+   gameos_dlog("init: ready %ux%u crtc %u/%u plane %u/%u",
+         g_gameos_span_w, g_gameos_span_mode.vdisplay,
+         g_gameos_crtc_top, g_gameos_crtc_bot,
+         g_gameos_plane_top, g_gameos_plane_bot);
+   drmModeFreeConnector(bot);
+   drmModeFreeResources(res);
+   return true;
+
+fail:
+   drmModeFreeConnector(bot);
+   drmModeFreeResources(res);
+   return false;
+}
+
+static bool gameos_dual_modeset(int fd, uint32_t fb_id)
+{
+   drmModeAtomicReq *req = drmModeAtomicAlloc();
+   if (!req)
+      return false;
+
+   bool ok = true;
+
+   /* Route each connector to its CRTC. This is the binding the legacy
+    * drmModeSetCrtc path did implicitly; atomic requires it explicitly or
+    * the panels receive no scanout and stay black. */
+   ok &= gameos_add_prop(req, g_gameos_conn_top, g_gc_conn_top,
+         g_gameos_crtc_top);
+   ok &= gameos_add_prop(req, g_gameos_conn_bot, g_gc_conn_bot,
+         g_gameos_crtc_bot);
+
+   ok &= gameos_add_prop(req, g_gameos_crtc_top,
+         g_gc_mode_top, g_gameos_blob_top);
+   ok &= gameos_add_prop(req, g_gameos_crtc_top, g_gc_active_top, 1);
+   ok &= gameos_add_prop(req, g_gameos_crtc_bot,
+         g_gc_mode_bot, g_gameos_blob_bot);
+   ok &= gameos_add_prop(req, g_gameos_crtc_bot, g_gc_active_bot, 1);
+
+   /* top panel: FB rows [0, top_h) */
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.fb_id, fb_id);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.crtc_id,
+         g_gameos_crtc_top);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.src_x, 0);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.src_y, 0);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.src_w,
+         (uint64_t)g_gameos_span_w << 16);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.src_h,
+         (uint64_t)g_gameos_top_h << 16);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.crtc_x, 0);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.crtc_y, 0);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.crtc_w,
+         g_gameos_span_w);
+   ok &= gameos_add_prop(req, g_gameos_plane_top, g_gp_top.crtc_h,
+         g_gameos_top_h);
+
+   /* bottom panel: FB rows [top_h, top_h + bot_h) */
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.fb_id, fb_id);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.crtc_id,
+         g_gameos_crtc_bot);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.src_x, 0);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.src_y,
+         (uint64_t)g_gameos_top_h << 16);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.src_w,
+         (uint64_t)g_gameos_span_w << 16);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.src_h,
+         (uint64_t)g_gameos_mode_bot.vdisplay << 16);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.crtc_x, 0);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.crtc_y, 0);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.crtc_w,
+         g_gameos_span_w);
+   ok &= gameos_add_prop(req, g_gameos_plane_bot, g_gp_bot.crtc_h,
+         g_gameos_mode_bot.vdisplay);
+
+   if (!ok)
+   {
+      drmModeAtomicFree(req);
+      return false;
+   }
+
+   /* Validate the whole request without applying it. If the kernel rejects
+    * the dual-panel configuration we bail out before touching the display,
+    * so the caller can fall back to single-panel mode cleanly. */
+   int ret = drmModeAtomicCommit(fd, req,
+         DRM_MODE_ATOMIC_TEST_ONLY | DRM_MODE_ATOMIC_ALLOW_MODESET, NULL);
+   if (ret < 0)
+   {
+      RARCH_ERR("[KMS] gameOS dual modeset TEST_ONLY rejected: %s\n",
+            strerror(errno));
+      gameos_dlog("modeset: TEST_ONLY rejected: %s (%d)",
+            strerror(errno), errno);
+      drmModeAtomicFree(req);
+      return false;
+   }
+
+   gameos_dlog("modeset: TEST_ONLY accepted, committing");
+   ret = drmModeAtomicCommit(fd, req,
+         DRM_MODE_ATOMIC_ALLOW_MODESET, NULL);
+   drmModeAtomicFree(req);
+   if (ret < 0)
+   {
+      RARCH_ERR("[KMS] gameOS dual modeset failed: %s\n",
+            strerror(errno));
+      gameos_dlog("modeset: commit failed: %s (%d)",
+            strerror(errno), errno);
+   }
+   else
+      gameos_dlog("modeset: commit ok");
+   return ret == 0;
+}
+
+static bool gameos_dual_flip(int fd, uint32_t fb_id, bool *waiting)
+{
+   drmModeAtomicReq *req = drmModeAtomicAlloc();
+   if (!req)
+      return false;
+   drmModeAtomicAddProperty(req, g_gameos_plane_top, g_gp_top.fb_id, fb_id);
+   drmModeAtomicAddProperty(req, g_gameos_plane_bot, g_gp_bot.fb_id, fb_id);
+   int ret = drmModeAtomicCommit(fd, req,
+         DRM_MODE_PAGE_FLIP_EVENT, waiting);
+   drmModeAtomicFree(req);
+   if (ret == 0)
+      *waiting = true;
+   else if (g_gameos_flip_errors < 3)
+   {
+      g_gameos_flip_errors++;
+      RARCH_ERR("[KMS] gameOS dual flip failed: %s\n", strerror(errno));
+      gameos_dlog("flip: failed: %s", strerror(errno));
+   }
+   return ret == 0;
+}
+/* === end gameOS dual-screen support === */
+
+
 static float mode_vrefresh(drmModeModeInfo *mode)
 {
    return  mode->clock * 1000.00f / (mode->htotal * mode->vtotal);
