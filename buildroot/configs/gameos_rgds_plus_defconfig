# gameOS for Anbernic RG DS Plus (Rockchip RK3568, dual 1024x768 DSI)
#
# Boot chain note:
#   U-Boot v2026.01 on the quartz64-a-rk3566 base (no Anbernic board
#   detection code that crashes with mainline ATF) PLUS two
#   RG DS Plus fixes (RK8XX boot-on-power-key, SD-card-first SPL boot
#   order) PLUS gameOS' own SPL_MMC=y (quartz64 SPL is SPI-only and this
#   device has no SPI flash). The kernel DTB is selected explicitly
#   via extlinux.conf FDT, and DDR init uses the RK3568 v1.26 blob.

# --- Architecture / toolchain ---
BR2_aarch64=y
BR2_cortex_a55=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_VENDOR="gameos"
BR2_ENABLE_LOCALE=y
BR2_USE_WCHAR=y
# Fixed 6.12 LTS headers (older than the 7.2.11 kernel we run, which
# is the supported direction). The old CUSTOM_6_12 line only declared
# a series while the source defaulted to "same as kernel" (7.2.x),
# failing the strict headers check.
BR2_KERNEL_HEADERS_6_12=y

# --- System ---
# eudev is mandatory: 99-gameos-input.rules hides the raw gpio-keys /
# adc-joystick devices so RetroArch/PPSSPP only see inputd's merged pad.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_HOSTNAME="gameos"
BR2_TARGET_GENERIC_ISSUE="gameOS"
BR2_TARGET_GENERIC_GETTY=n
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=y
# Timezone database for the first-boot wizard. gameos-setup stores the chosen
# zone on /userdata and re-applies /etc/localtime at every boot, because OTA
# replaces the whole rootfs. "default" zonelist is the ~5.5M common set.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="default"
BR2_TARGET_LOCALTIME="Asia/Shanghai"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/post-image.sh"
# Out-of-tree package fixes (bluez5: restore bluetoothctl non-interactive
# stdout). Layout: patches/<pkg>/<version>/NNNN-*.patch.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_GAMEOS_PATH)/patches"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/busybox-fragment.config"

# --- Kernel: mainline 7.2.11 (matches the vendored RK3566 patch set) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://www.kernel.org/pub/linux/kernel/v7.x/linux-7.2.11.tar.xz"
# Kernel patches are applied by GAMEOS_LINUX_APPLY_PATCHES (external.mk) in
# the order pinned by kernel-patches/series, with fuzz 2; Buildroot's own
# patch step (-F0, zero fuzz) would reject five upstream patches that need fuzz.
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/linux-fragment.config"
BR2_LINUX_KERNEL_IMAGE=y
# DTS_SUPPORT gates INTREE_DTS_NAME: without it olddefconfig silently
# drops the DTS list, no DTBs are installed, and the board never boots.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3568-anbernic-rg-ds-plus rockchip/rk3568-anbernic-rg-ds"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# --- U-Boot: quartz64 base + RG DS Plus proven fixes (see header note) ---
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL_LOCATION="https://github.com/u-boot/u-boot/archive/refs/tags/v2026.01.tar.gz"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="quartz64-a-rk3566"
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/uboot-patches"
# A/B boot: boot.scr picks slot A/B and rolls back after 4 unconfirmed boots
# (needs CMD_SETEXPR for the counter; the command runs boot.scr first).
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GAMEOS_PATH)/board/gameos/rgds-plus/uboot-fragment.config"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_ROCKCHIP_RKBIN=y
# RK3568 with SPL selects CONFIG_BINMAN: u-boot.itb / idbloader.img /
# u-boot-rockchip.bin are produced by binman during 'make all', NOT as
# standalone make targets. USE_BINMAN tells Buildroot to stop requesting
# 'u-boot.itb' explicitly (run 6: "No rule to make target 'u-boot.itb'")
# and to pass BINMAN_INDIRS so binman finds the rkbin blobs.
BR2_TARGET_UBOOT_USE_BINMAN=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_FORMAT_ITB=y

# --- Rockchip firmware blobs (pinned via local.mk override) ---
# The override file is read BEFORE package recipes are evaluated; an
# override set in external.mk would be too late (run 5 downloaded the
# wrong rkbin revision and failed on the missing v1.46 BL31 blob).
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_GAMEOS_PATH)/local.mk"
BR2_PACKAGE_ROCKCHIP_RKBIN=y
BR2_PACKAGE_ROCKCHIP_RKBIN_TPL_FILENAME="bin/rk35/rk3568_ddr_1560MHz_v1.26.bin"
BR2_PACKAGE_ROCKCHIP_RKBIN_BL31_FILENAME="bin/rk35/rk3568_bl31_v1.46.elf"

# --- Graphics: Mali-G52 via Panfrost, SDL2 straight on KMS/DRM ---
# In Buildroot 2026.08 the panfrost gallium driver depends on
# MESA3D_LLVM, and SDL2_KMSDRM needs HAS_LIBGBM (mesa gbm, which
# needs a gallium driver + EGL). Enable the full chain explicitly.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SDL2_IMAGE=y

# --- Audio ---
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y

# --- Bluetooth (off by default; gameos-bt starts the stack on demand) ---
# bluez-alsa selects bluez5-utils + its audio plugin, dbus, libglib2 and sbc;
# HID/HOG plugins serve classic and LE controllers. libopenaptx adds aptX/HD.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ_ALSA=y
BR2_PACKAGE_LIBOPENAPTX=y

# --- Input / system utilities ---
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_EXFATPROGS=y
# sgdisk -e relocates the backup GPT to the true end of a larger card before
# S20gameos creates the data partition (deterministic vs parted auto-fix).
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_EVTEST=y
# partx -a registers the freshly created data partition with the kernel on
# first boot (blockdev --rereadpt refuses while root is mounted from p2).
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
# RTL8821CS WiFi uses the rtw88 driver (RTL_88XX only covers old rtlwifi
# chips); its BT half needs rtl_bt/rtl8821cs_fw.bin + config (RTL_88XX_BT).
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
# regulatory.db: without it cfg80211 falls back to the usermode firmware
# helper and stalls boot ~60s.
BR2_PACKAGE_WIRELESS_REGDB=y
# WiFi client stack: wpa_supplicant over nl80211 + wpa_cli driven by the UI,
# busybox udhcpc for the lease. WPA3 pulls in OpenSSL (needed for OTA too).
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# OTA manifest verification uses the openssl CLI (Ed25519); the library is
# already pulled in by WPA3, this only adds the binary.
BR2_PACKAGE_LIBOPENSSL_BIN=y
# OTA: HTTPS download of the release manifest and images (GitHub redirects to
# objects.githubusercontent.com, so curl's redirect + TLS handling is used
# instead of busybox wget), with the Mozilla bundle for certificate checks.
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Per-game overrides (game_overrides.json) are validated with json-c.
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_ZLIB=y

# --- gameOS components ---
BR2_PACKAGE_GAMEOS_INPUTD=y
BR2_PACKAGE_GAMEOS_SLEEPD=y
BR2_PACKAGE_GAMEOS_UI=y
BR2_PACKAGE_GAMEOS_RETROARCH=y
BR2_PACKAGE_GAMEOS_CORE_MELONDS=y
BR2_PACKAGE_GAMEOS_CORE_MGBA=y
BR2_PACKAGE_GAMEOS_CORE_GPSP=y
BR2_PACKAGE_GAMEOS_CORE_PCSX=y
BR2_PACKAGE_GAMEOS_PPSSPP=y

# --- Root filesystem ---
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1200M"
BR2_TARGET_ROOTFS_EXT2_LABEL="GAMEOS-ROOT"

# --- Host tools for image assembly ---
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y