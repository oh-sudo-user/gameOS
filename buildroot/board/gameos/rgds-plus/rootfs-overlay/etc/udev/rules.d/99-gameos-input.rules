# gameOS: the RG DS Plus exposes buttons (gpio-keys-control) and analog stick
# (adc-joystick) as TWO evdev devices. gameos-inputd merges them into one
# virtual "gameOS Gamepad". Hide the raw devices from SDL/RetroArch so they
# only ever see the merged pad (otherwise player 1 gets a buttons-only pad).
SUBSYSTEM=="input", ATTRS{name}=="gpio-keys-control", ENV{ID_INPUT_JOYSTICK}="0", ENV{ID_INPUT_KEYBOARD}="0", ENV{ID_INPUT_KEY}="0"
SUBSYSTEM=="input", ATTRS{name}=="adc-joystick", ENV{ID_INPUT_JOYSTICK}="0", ENV{ID_INPUT_KEYBOARD}="0", ENV{ID_INPUT_KEY}="0"
# adc-keys-home (BTN_BACK) is merged into the pad by inputd; adc-keys-play is
# reserved. Hide both so RetroArch doesn't grab them as phantom joypads.
SUBSYSTEM=="input", ATTRS{name}=="adc-keys-home", ENV{ID_INPUT_JOYSTICK}="0", ENV{ID_INPUT_KEYBOARD}="0", ENV{ID_INPUT_KEY}="0"
SUBSYSTEM=="input", ATTRS{name}=="adc-keys-play", ENV{ID_INPUT_JOYSTICK}="0", ENV{ID_INPUT_KEYBOARD}="0", ENV{ID_INPUT_KEY}="0"
# gameos-inputd drives ALSA from gpio-keys-volume. Hide the raw device too,
# otherwise SDL/RetroArch see a second keyboard and double-handle the keys.
SUBSYSTEM=="input", ATTRS{name}=="gpio-keys-volume", ENV{ID_INPUT_JOYSTICK}="0", ENV{ID_INPUT_KEYBOARD}="0", ENV{ID_INPUT_KEY}="0"
# Make sure the merged pad is always tagged as a joystick: SDL's udev backend
# only enumerates devices with ID_INPUT_JOYSTICK=1, and eudev's input_id
# builtin may not tag uinput devices reliably on this setup.
SUBSYSTEM=="input", ATTRS{name}=="gameOS Gamepad", ENV{ID_INPUT_JOYSTICK}="1"