#!/bin/sh
# Route the ALSA default device and pin 48 kHz on both streams.
#
# The aw88166 speaker amps consume 48 kHz whatever the I2S rate is (44.1 kHz
# material plays ~9% fast and pitched up), so playback is always opened at
# 48 kHz and plug resamples. Capture is pinned to the same rate because
# playback and capture share one I2S DAI that rockchip-i2s-tdm marks
# symmetric_rate: a 44.1 kHz microphone open next to 48 kHz playback is
# refused outright. route_policy copy keeps a mono recorder on the left
# channel (the mic) instead of plug's L/R average, which can cancel a
# differential input to silence.
#
# Cards are found by name, not index: probe order swaps rk817 (jack) and
# aw88166 (speakers) between boots. Headphone jack state is polled so the
# route follows the plug; a running emulator re-reads ALSA on next launch.
#
# Bluetooth headphones (gameos-bt) take over playback via bluealsa's PCM while
# /run/gameos/bt-audio holds their MAC. /run/gameos/bt-hold means they are being
# called back after a sleep: playback then goes to the rk817, which on the Plus
# drives only the jack — silent with nothing plugged in, but a real device clock
# so a woken game keeps its pace instead of blasting the speakers.

PIDFILE=/var/run/gameos-audio.pid

route_once()
{
    [ -r /proc/asound/cards ] || return 0
    spk=$(awk 'tolower($0) ~ /aw88166/ { print $1; exit }' /proc/asound/cards)
    codec=$(awk 'tolower($0) ~ /rk817/ { print $1; exit }' /proc/asound/cards)
    [ -n "$spk" ] || [ -n "$codec" ] || return 0
    [ -n "$codec" ] || codec=$spk

    jack=off
    if [ -n "$codec" ]; then
        j=$(amixer -c "$codec" cget name='Headphone Jack' 2>/dev/null \
            | awk -F= '/: values=/ { print $2; exit }')
        [ "$j" = "on" ] && jack=on
    fi

    btmac=
    [ -r /run/gameos/bt-audio ] && btmac=$(awk '{ print $1; exit }' /run/gameos/bt-audio)
    if [ -n "$btmac" ]; then
        play=bt
    elif [ -f /run/gameos/bt-hold ]; then
        play=$codec
    elif [ "$jack" = "on" ]; then
        play=$codec
    else
        play=${spk:-$codec}
    fi

    cap='"null"'
    [ -n "$codec" ] && cap="{ type plug route_policy copy slave { pcm \"hw:$codec\" format S16_LE channels 2 rate 48000 } }"

    # plug converts to whatever bluealsa negotiated (no 48 kHz pin: the codec's
    # own rate, usually 44.1 kHz SBC); the hw paths stay pinned for the aw88166
    if [ "$play" = bt ]; then
        playpcm="{ type bluealsa device \"$btmac\" profile \"a2dp\" }"
        playline="    playback.pcm { type plug slave.pcm $playpcm }"
    else
        playline="    playback.pcm { type plug slave { pcm \"hw:$play\" format S16_LE channels 2 rate 48000 } }"
    fi
    ctlcard=${codec:-$spk}

    tmp=/etc/asound.conf.tmp
    {
        echo "# gameos-audio: play=$play jack=$jack bt=$btmac"
        echo "pcm.!default {"
        echo "    type asym"
        echo "$playline"
        echo "    capture.pcm $cap"
        echo "}"
        [ -n "$ctlcard" ] && echo "ctl.!default { type hw card $ctlcard }"
    } > "$tmp"
    if cmp -s "$tmp" /etc/asound.conf; then
        rm -f "$tmp"
    else
        mv -f "$tmp" /etc/asound.conf
    fi
}

case "$1" in
    start)
        /usr/bin/gameos-bootstage 80 audio
        route_once
        (
            while :; do
                sleep 2
                route_once
            done
        ) &
        echo $! > "$PIDFILE"
        ;;
    stop)
        [ -r "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac