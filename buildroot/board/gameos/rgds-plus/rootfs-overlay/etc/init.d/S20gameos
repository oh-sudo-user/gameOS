#!/bin/sh
# gameOS system setup: data partition, performance governors, panel driver.
# Runs after udev (S02udev) so block devices / by-partlabel symlinks exist.

LOG=/tmp/gameos-setup.log
log() { echo "[gameos-setup] $*" >> "$LOG"; }

# The setup log starts on tmpfs (the data partition does not exist yet). Once
# a card partition is mounted, copy this boot's log there so a failed setup can
# be diagnosed by reading the card on a PC; /boot and /userdata are both on it.
persist_log() {
  [ -f "$LOG" ] || return 0
  dst=""
  if mountpoint -q /userdata 2>/dev/null; then
    mkdir -p /userdata/system/logs 2>/dev/null
    [ -w /userdata/system/logs ] && dst=/userdata/system/logs/setup.log
  fi
  if [ -z "$dst" ] && mountpoint -q /boot 2>/dev/null; then
    mkdir -p /boot/logs 2>/dev/null
    [ -w /boot/logs ] && dst=/boot/logs/setup.log
  fi
  [ -n "$dst" ] || return 0
  [ "$(wc -c < "$dst" 2>/dev/null || echo 0)" -gt 524288 ] && mv -f "$dst" "$dst.1"
  {
    echo "----- boot $(date '+%F %T' 2>/dev/null) uptime $(cut -d' ' -f1 /proc/uptime 2>/dev/null)s -----"
    cat "$LOG"
  } >> "$dst" 2>/dev/null
}
log "start"
/usr/bin/gameos-bootstage 10 storage

# --- locate the boot disk from the ROOT partition (NOT a fixed mmcblk0) -----
# RG DS Plus: eMMC = mmc0 (sdhci, non-removable), TF slot = mmc1 (sdmmc0).
# With no eMMC populated the card enumerates as /dev/mmcblk1, so hardcoding
# mmcblk0 would wait on the wrong disk and never create/mount the data
# partition. The kernel boots from slot A or B (GAMEOS-ROOT-A / GAMEOS-ROOT-B
# chosen by boot.scr); derive the parent disk from whatever device holds root.
DEV=""
root_src=$(awk '$2 == "/" { print $1; exit }' /proc/self/mounts 2>/dev/null)
case "$root_src" in
  /dev/mmcblk*p[0-9]*) DEV=${root_src%p[0-9]*} ;;
  /dev/nvme*p[0-9]*)   DEV=${root_src%p[0-9]*} ;;
  /dev/sd*[0-9]*)      DEV=${root_src%[0-9]*} ;;
  /dev/hd*[0-9]*)      DEV=${root_src%[0-9]*} ;;
esac
# Fallback: resolve the GPT partlabel symlink (udev) when /proc/mounts shows
# root as /dev/root or a label rather than a usable partition node.
if [ -z "$DEV" ] || [ ! -b "$DEV" ]; then
  rp=$(readlink -f /dev/disk/by-partlabel/GAMEOS-ROOT-A 2>/dev/null)
  case "$rp" in
    /dev/mmcblk*p[0-9]*) DEV=${rp%p[0-9]*} ;;
    /dev/nvme*p[0-9]*)   DEV=${rp%p[0-9]*} ;;
    /dev/sd*[0-9]*)      DEV=${rp%[0-9]*} ;;
  esac
fi
if [ -z "$DEV" ] || [ ! -b "$DEV" ]; then
  log "ERROR: cannot determine boot disk (root_src='$root_src'); skipping data setup"
  exit 0
fi
log "boot disk = $DEV (root source '$root_src')"

# --- mount the boot partition: persistent log fallback ----------------------
# /userdata may be unavailable (first boot, format failure); /boot always
# exists so diagnostics (system/logs/ui.log, else /boot/logs/ui.log) survive
# reboots either way.
mkdir -p /boot
if ! mountpoint -q /boot; then
  mount -t vfat ${DEV}p1 /boot 2>>"$LOG" || log "WARN: could not mount /boot"
fi
/usr/bin/gameos-bootstage 20 storage

# --- wait for the disk node (already present since we booted from it) ------
i=0
while [ ! -b "$DEV" ] && [ $i -lt 100 ]; do
  sleep 0.1
  i=$((i + 1))
done
if [ ! -b "$DEV" ]; then
  log "ERROR: $DEV never appeared"
  persist_log
  exit 0
fi

/usr/bin/gameos-bootstage 30 data

# --- first boot: create the GAMEOS-DATA exFAT partition filling the card ---
# INVARIANT: an EXISTING p4 is NEVER auto-formatted, no matter what. Every
# rootfs image carries /etc/gameos-firstboot (post-build.sh touches it), so the
# first boot into a freshly OTA-written slot runs this block with the user's
# data partition already present. Formatting is permitted ONLY for a partition
# this boot just created (p4 node was absent and sgdisk/parted succeeded).
#
# Do NOT use blkid to detect the filesystem: /sbin/blkid here is busybox, which
# ignores -o/-s and (CONFIG_FEATURE_BLKID_TYPE unset) never prints TYPE. Detect
# by actually mounting read-only -- the kernel checks the superblock magic.
FIRSTBOOT=0
if [ -f /etc/gameos-firstboot ]; then
  FIRSTBOOT=1
  if [ -b ${DEV}p4 ]; then
    # p4 EXISTS: only an exFAT read-only mount counts as our GAMEOS-DATA.
    # Any other filesystem, corruption or I/O error is preserved untouched
    # and reported; the marker is kept so a later boot can retry the probe
    # (e.g. after the user repairs the card on a PC). Never mkfs here.
    probe=/tmp/gameos-data-probe
    mkdir -p "$probe"
    if mount -t exfat -o ro ${DEV}p4 "$probe" 2>>"$LOG"; then
      umount "$probe" 2>/dev/null
      rm -f /etc/gameos-firstboot
      log "existing GAMEOS-DATA exFAT detected; preserved"
    else
      log "ERROR: existing p4 cannot be mounted exFAT; refusing to format (user data preserved)"
    fi
    rmdir "$probe" 2>/dev/null
  else
    # p4 ABSENT: create it. Only a partition created successfully THIS boot
    # may be formatted; every creation step is exit-code gated.
    created=0
    if command -v sgdisk >/dev/null 2>&1; then
      # The flashed image is only ~1.5 GiB, so on a larger card the backup
      # GPT header still sits at the end of the SMALL image. Relocate it to
      # the true end of the disk FIRST (sgdisk -e) so "0:0" (first available
      # .. last usable) is deterministic.
      if sgdisk -e "$DEV" >>"$LOG" 2>&1; then
        blockdev --rereadpt "$DEV" 2>/dev/null || true
        # 0700 = Microsoft basic data, recognised by Linux and Windows for
        # the exFAT data partition (parted has no exfat fs-type token).
        if sgdisk -n 4:0:0 -t 4:0700 -c 4:GAMEOS-DATA "$DEV" >>"$LOG" 2>&1; then
          created=1
        else
          log "ERROR: sgdisk create p4 failed; not formatting"
        fi
      else
        log "ERROR: sgdisk -e (relocate backup GPT) failed; not creating p4"
      fi
    elif command -v parted >/dev/null 2>&1; then
      if parted -s "$DEV" mkpart GAMEOS-DATA 2688MiB 100% >>"$LOG" 2>&1; then
        created=1
      else
        log "ERROR: parted create p4 failed; not formatting"
      fi
    else
      log "ERROR: no sgdisk/parted available; cannot create GAMEOS-DATA"
    fi

    if [ "$created" = 1 ]; then
      # Give the kernel a moment to re-read the table. BLKRRPART refuses while
      # root is mounted from ROOT-A/B, so partx adds just p4 via BLKPG, which
      # works even with the other partitions in use.
      sleep 1
      blockdev --rereadpt "$DEV" 2>/dev/null || true
      if command -v partx >/dev/null 2>&1; then
        partx -a -n 4 "$DEV" >>"$LOG" 2>&1 || true
      fi
      j=0
      while [ ! -b ${DEV}p4 ] && [ $j -lt 50 ]; do sleep 0.1; j=$((j + 1)); done
      if [ ! -b ${DEV}p4 ]; then
        log "ERROR: p4 node never appeared after create; not formatting"
      elif mkfs.exfat -n GAMEOS ${DEV}p4 >>"$LOG" 2>&1; then
        # Verify the new filesystem mounts read-only before clearing the
        # marker; a failed verify keeps the marker for a retry.
        probe=/tmp/gameos-data-probe
        mkdir -p "$probe"
        if mount -t exfat -o ro ${DEV}p4 "$probe" 2>>"$LOG"; then
          umount "$probe" 2>/dev/null
          rm -f /etc/gameos-firstboot
          log "newly-created GAMEOS-DATA formatted exfat and verified"
        else
          log "ERROR: new p4 formatted but verify mount failed; keeping marker"
        fi
        rmdir "$probe" 2>/dev/null
      else
        log "ERROR: mkfs.exfat on newly-created p4 failed; keeping marker"
      fi
    fi
  fi
fi

# --- mount userdata ---------------------------------------------------------
mkdir -p /userdata
if ! mountpoint -q /userdata; then
  mount -t exfat -o utf8 ${DEV}p4 /userdata 2>>"$LOG" \
    || mount -t exfat ${DEV}p4 /userdata 2>>"$LOG" \
    || log "WARN: could not mount GAMEOS-DATA"
fi
/usr/bin/gameos-bootstage 45 data

# --- ROM / save / BIOS directory skeleton ----------------------------------
# Only build the skeleton and write emulator configs when /userdata is REALLY
# the mounted data partition. If the mount failed, /userdata is a plain dir on
# the rootfs: creating dirs/files there would fill the small root filesystem
# and lose user data on reboot. Skip it and let the UI report "no games".
if mountpoint -q /userdata; then
  for d in nds gba gbc ps1 psp; do
    mkdir -p "/userdata/roms/$d"
  done
  mkdir -p /userdata/saves /userdata/bios /userdata/screenshots /userdata/system
  mkdir -p /userdata/system/logs

  # --- PPSSPP: default config (fullscreen, GLES, 2x render resolution) ------
  PPDIR=/userdata/system/ppsspp/.config/ppsspp/PSP/SYSTEM
  mkdir -p "$PPDIR"
  if [ ! -f "$PPDIR/ppsspp.ini" ]; then
    cat > "$PPDIR/ppsspp.ini" <<'EOF'
[General]
FirstRun = False
[Graphics]
FullScreen = True
Backend = 0
RenderingResolution = 2
VSync = True
ShowFPSCounter = False
[Sound]
Enable = True
GlobalVolume = 8
EOF
    log "wrote default ppsspp.ini"
  fi

  # Timezone and hostname live on /userdata: OTA replaces the whole rootfs,
  # so /etc/localtime and /etc/hostname are re-derived from it every boot.
  /usr/bin/gameos-setup apply >>"$LOG" 2>&1
else
  log "WARN: /userdata not mounted; skipping data skeleton (rootfs protected)"
fi

# --- second microSD slot (TF2) ---------------------------------------------
# udev also runs this on every card event; doing it here as well covers a card
# that was already in the slot at boot, before the UI starts scanning.
if [ -x /usr/bin/gameos-tf2 ]; then
  /usr/bin/gameos-tf2 auto >>"$LOG" 2>&1
  log "tf2: $(sed -n 's/^state=//p' /run/gameos/tf2 2>/dev/null)"
fi
/usr/bin/gameos-bootstage 60 data

# --- performance: apply the UI profile via gameos-perf ----------------------
# gameos-perf reads each policy's scaling_available_governors and only writes
# governors the kernel actually offers (schedutil -> ondemand -> performance
# fallback), logging every action. GPU policy comes from /etc/gameos/perf.conf.
# No fixed frequencies are written. Failures here never block boot.
if [ -x /usr/bin/gameos-perf ]; then
  /usr/bin/gameos-perf ui >>"$LOG" 2>&1
fi

# --- dual DSI panel driver --------------------------------------------------
# panel-generic-dsi is built INTO the kernel (obj-y, see external.mk), so both
# panels are probed before DRM binds; nothing to load here.

# --- backlight: comfortable default (70%) -----------------------------------
for b in /sys/class/backlight/*; do
  if [ -w "$b/brightness" ]; then
    max=$(cat "$b/max_brightness")
    echo $((max * 70 / 100)) > "$b/brightness"
  fi
done

# --- keep the console from blanking over the UI ------------------------------
[ -w /sys/module/kernel/parameters/consoleblank ] && \
  echo 0 > /sys/module/kernel/parameters/consoleblank

# --- audio: sane default speaker volume ONLY on first boot ------------------
# On later boots the UI restores the user's saved volume (apply_volume at
# startup); forcing 70% here every boot would discard the user's setting.
if [ "$FIRSTBOOT" = 1 ]; then
  gameos-volume set 70 >/dev/null 2>&1 || true
fi

log "done"
persist_log