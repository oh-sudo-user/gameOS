#!/bin/sh
# gameOS WiFi: RTL8821CS (rtw88_8821cs over SDIO) + wpa_supplicant (nl80211)
# + udhcpc. The UI drives everything through this helper so a 20 s association
# never blocks the render loop; settings survive reboots on the exFAT data
# partition.
#
#   gameos-wifi status          key=value lines (state, ssid, ip, iface)
#   gameos-wifi scan            SIGNAL <tab> SECURE <tab> SSID, strongest first
#   gameos-wifi connect         reads /run/gameos/wifi-arg: line 1 = SSID,
#                               line 2 = passphrase (empty = open / saved)
#                               last line "OK <ip>" or "ERROR <why>"
#   gameos-wifi disconnect      drop the link, kill DHCP lease
#   gameos-wifi test            staged connectivity check, key=value lines
#                               (link, route, dns, net) then OK / ERROR <stage>
#   gameos-wifi forget          reads wifi-arg line 1 = SSID, drop it from disk
#   gameos-wifi known           saved SSIDs: SSID <tab> 1 (has key) / 0 (open)
#   gameos-wifi up | down       bring the supplicant up/down (S30wifi)
#
# Saved networks: /userdata/system/wifi/nets/<md5>.net holds the SSID on line 1
# and the passphrase on line 2. wpa_supplicant.conf is regenerated from them
# after every change so there is exactly one source of truth.

RUN=/run/gameos
WIFI_DIR=/userdata/system/wifi
NETS=$WIFI_DIR/nets
CONF=$WIFI_DIR/wpa_supplicant.conf
ARG=$RUN/wifi-arg
SOCK=/run/wpa_supplicant
IFACE=${WIFI_IFACE:-}
# every wpa_cli call must be bounded: when the supplicant wedges, an untimed
# wpa_cli blocked do_up forever, kept the flock below held, and every UI scan
# then waited on that lock with no log line at all ("stuck searching").
WPA="timeout 5 wpa_cli -p $SOCK"
ACTION=/etc/gameos/wpa_action.sh
CA=/etc/ssl/certs/ca-certificates.crt
LOG=/userdata/system/wifi.log
WPA_LOG=/userdata/system/wpa_supplicant.log
WPS_ERR=/userdata/system/wpa_supplicant.err.log

mkdir -p "$RUN"

have_data() { mountpoint -q /userdata 2>/dev/null; }

# stdout belongs to the caller (status/scan parsing), so diagnostics go to a
# file on the card. The data partition is exFAT, so this is readable on a PC.
log() {
    have_data || return 0
    printf '[%s +%ss] [gameos-wifi] %s\n' \
        "$(date '+%F %T' 2>/dev/null)" \
        "$(cut -d. -f1 /proc/uptime 2>/dev/null)" "$*" >> "$LOG"
    return 0
}

now_s() { cut -d. -f1 /proc/uptime 2>/dev/null; }

rotate() {  # $1 file, $2 max bytes
    have_data || return 0
    [ -f "$1" ] || return 0
    sz=$(wc -c < "$1" 2>/dev/null || echo 0)
    [ "$sz" -gt "$2" ] && mv -f "$1" "$1.1"
    return 0
}

log_tail() {  # $1 file, $2 tag, $3 lines
    [ -f "$1" ] || return 0
    tail -n "$3" "$1" 2>/dev/null \
        | while IFS= read -r l; do log "$2: $l"; done
}

rfkill_state() {
    out=""
    for r in /sys/class/rfkill/rfkill*; do
        [ -e "$r/type" ] || continue
        out="$out ${r##*/}:$(cat "$r/type" 2>/dev/null),soft=$(cat "$r/soft" 2>/dev/null),hard=$(cat "$r/hard" 2>/dev/null);"
    done
    echo "${out:-none}"
}

iface_list() {
    ls -d /sys/class/net/* 2>/dev/null | sed 's#.*/##' | tr '\n' ' '
}

# One snapshot per failure: module/rfkill/firmware state plus the kernel's
# view of SDIO/firmware events. This is what tells us why a scan stayed empty
# once the card is back in a PC.
diag_snapshot() {
    log "snapshot: uptime=$(cut -d. -f1 /proc/uptime 2>/dev/null)s ifaces=$(iface_list)"
    log "snapshot: rfkill=$(rfkill_state)"
    log "snapshot: modules=$(lsmod 2>/dev/null | awk '$1 ~ /^(rtw|cfg80211|mac80211|sdio)/ {printf "%s ", $1}')"
    log "snapshot: firmware=$(ls -l /lib/firmware/rtw88/rtw8821c_fw.bin 2>&1 | tr '\n' ';')"
    dmesg 2>/dev/null | grep -iE 'rtw|sdio|mmc|firmware|cfg80211|rfkill' | tail -n 40 \
        | while IFS= read -r l; do log "dmesg: $l"; done
}

# one operation at a time; the UI runs these in the background. busybox flock
# has no -w, so poll with -n instead of blocking indefinitely: a wedged helper
# must never starve the UI's scan.
case $1 in
up|down|connect|disconnect|forget|scan|test)
    exec 9>"$RUN/wifi.lock"
    i=0
    while ! flock -n 9; do
        i=$((i + 1))
        if [ $i -ge 15 ]; then
            log "op=$1: gave up waiting for wifi.lock after 15s"
            echo "ERROR busy"
            exit 1
        fi
        sleep 1
    done
    ;;
esac

iface() {
    [ -n "$IFACE" ] && [ -e "/sys/class/net/$IFACE" ] && { echo "$IFACE"; return; }
    for n in /sys/class/net/wlan*; do
        [ -e "$n" ] || continue
        IFACE=${n##*/}
        break
    done
    echo "$IFACE"
}

# rfkill soft-block is the usual reason the interface exists but scans return
# nothing; there is no rfkill binary in the image, so write the sysfs node.
rfkill_unblock() {
    for r in /sys/class/rfkill/rfkill*; do
        [ -e "$r/type" ] || continue
        [ "$(cat "$r/type" 2>/dev/null)" = wlan ] || continue
        [ -w "$r/soft" ] && echo 0 > "$r/soft" 2>/dev/null
    done
}

# At cold boot S25wireless may still be loading the module when the UI starts.
# Retry here so the first scan is not a permanent NOHW.
ensure_hw() {
    log "ensure_hw: begin iface=$(iface) rfkill=$(rfkill_state)"
    if [ -z "$(iface)" ]; then
        modprobe rtw88_8821cs 2>/dev/null
        log "ensure_hw: modprobe rtw88_8821cs rc=$?"
    fi
    rfkill_unblock
    i=0
    while [ -z "$(iface)" ] && [ $i -lt 6 ]; do
        sleep 1
        rfkill_unblock
        i=$((i + 1))
    done
    log "ensure_hw: end iface=$(iface) waited=${i}s rfkill=$(rfkill_state)"
    if [ -z "$(iface)" ]; then
        diag_snapshot
        return 1
    fi
    return 0
}

case $1 in
up|down|connect|disconnect|forget|scan|test)
    rotate "$LOG" 2097152
    log "op=$1 iface=$(iface) rfkill=$(rfkill_state)"
    ;;
esac

wpa_ok() { command -v wpa_cli >/dev/null 2>&1; }

# wpa_cli prints "FAIL" on an unresponsive socket; treat that as empty
w() { $WPA -i "$(iface)" "$@" 2>/dev/null | tr -d '\r'; }

state() { w status | sed -n 's/^wpa_state=//p'; }
link_ssid() { w status | sed -n 's/^ssid=//p'; }
link_ip() {
    ip -4 addr show "$(iface)" 2>/dev/null \
        | sed -n 's/^ *inet \([0-9.]*\)\/.*/\1/p' | head -n 1
}

supplicant_pid() { cat /run/wpa_supplicant."$(iface)".pid 2>/dev/null; }
supplicant_running() {
    p=$(supplicant_pid)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

start_supplicant() {
    [ -f "$CONF" ] || regen_conf
    supplicant_running && {
        log "supplicant already running pid=$(supplicant_pid) state=$(state)"
        return 0
    }
    enc=$(iface)
    [ -n "$enc" ] || { log "start_supplicant: no interface"; return 1; }
    rfkill_unblock
    ip link set "$enc" up 2>/dev/null
    mkdir -p "$SOCK"
    rotate "$WPA_LOG" 4194304
    rotate "$WPS_ERR" 1048576
    log "start_supplicant: launching on $enc rfkill=$(rfkill_state)"
    # 9>&-: the daemon must not inherit the wifi.lock fd 9, or it holds the
    # lock for good and every later scan waits 15 s and fails with "ERROR busy".
    wpa_supplicant -B -D nl80211 -i "$enc" -c "$CONF" -f "$WPA_LOG" \
        -P "/run/wpa_supplicant.$enc.pid" >/dev/null 2>>"$WPS_ERR" 9>&- || {
        log "start_supplicant: wpa_supplicant failed to start on $enc"
        log_tail "$WPS_ERR" "wps-err" 20
        diag_snapshot
        return 1
    }
    # -B reports success even when the daemon dies right after parsing the
    # command line, so require a live pid instead of trusting the exit code.
    i=0
    p=""
    while [ $i -lt 20 ]; do
        p=$(supplicant_pid)
        [ -n "$p" ] && kill -0 "$p" 2>/dev/null && break
        sleep 0.1
        i=$((i + 1))
    done
    if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then
        log "start_supplicant: no running process after launch"
        log_tail "$WPS_ERR" "wps-err" 20
        diag_snapshot
        return 1
    fi
    log "start_supplicant: pid=$p"
    # give the control socket a moment, then require an actual answer. Bounded
    # by wall clock, not by iterations: each state() call may itself burn its
    # 5 s timeout when the daemon is wedged.
    end=$(( $(now_s) + 8 ))
    while [ "$(now_s)" -lt "$end" ]; do
        st=$(state)
        [ -n "$st" ] && { log "start_supplicant: ready state=$st"; return 0; }
        sleep 0.2
    done
    log "start_supplicant: did not answer on $enc"
    log_tail "$WPA_LOG" "wpa" 30
    diag_snapshot
    return 1
}

stop_supplicant() {
    p=$(supplicant_pid)
    [ -n "$p" ] && kill "$p" 2>/dev/null
    rm -f "/run/wpa_supplicant.$(iface).pid"
    kill_lease
    ip link set "$(iface)" down 2>/dev/null
}

# --- saved-network store ---------------------------------------------------
net_id() { printf '%s' "$1" | md5sum | cut -d' ' -f1; }
net_file() { echo "$NETS/$(net_id "$1").net"; }

save_net() {   # $1 ssid, $2 psk ("" = open)
    mkdir -p "$NETS"
    f=$(net_file "$1")
    { printf '%s\n' "$1"; printf '%s\n' "$2"; } > "$f.tmp" && mv -f "$f.tmp" "$f"
}

drop_net() { rm -f "$(net_file "$1")"; }

saved_psk() {  # empty if unknown
    f=$(net_file "$1")
    [ -f "$f" ] || return 0
    sed -n '2p' "$f"
}

known_nets() {
    [ -d "$NETS" ] || return 0
    for f in "$NETS"/*.net; do
        [ -f "$f" ] || continue
        sed -n '1p' "$f"
    done
}

conf_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

regen_conf() { # $1 = SSID to prefer (optional)
    mkdir -p "$WIFI_DIR"
    {
        printf 'ctrl_interface=%s\n' "$SOCK"
        printf 'update_config=0\n'
        printf 'country=CN\n'
        printf 'ap_scan=1\n'
        printf 'bgscan="simple:30:-70:3600"\n'
        printf '\n'
        known_nets | while IFS= read -r ssid; do
            [ -n "$ssid" ] || continue
            psk=$(saved_psk "$ssid")
            printf 'network={\n'
            printf '\tssid="%s"\n' "$(conf_escape "$ssid")"
            if [ -n "$psk" ]; then
                printf '\tpsk="%s"\n' "$(conf_escape "$psk")"
                printf '\tscan_ssid=1\n'
            else
                printf '\tkey_mgmt=NONE\n'
            fi
            [ "$ssid" = "$1" ] && printf '\tpriority=10\n' || printf '\tpriority=1\n'
            printf '}\n\n'
        done
    } > "$CONF.tmp" && mv -f "$CONF.tmp" "$CONF"
    chmod 600 "$CONF" 2>/dev/null
}

lease() {
    enc=$(iface)
    [ -n "$enc" ] || return 0
    kill_lease
    # 9>&- likewise: udhcpc -b backgrounds itself with fd 9 inherited.
    udhcpc -i "$enc" -b -R -p "/run/udhcpc.$enc.pid" >/dev/null 2>&1 9>&-
    log "udhcpc: started iface=$enc pid=$(cat "/run/udhcpc.$enc.pid" 2>/dev/null) state=$(state)"
}

kill_lease() {
    enc=$(iface)
    [ -n "$enc" ] || return 0
    p=$(cat "/run/udhcpc.$enc.pid" 2>/dev/null)
    [ -n "$p" ] && { kill "$p" 2>/dev/null; log "udhcpc: killed pid=$p"; }
    rm -f "/run/udhcpc.$enc.pid"
}

# --- operations ------------------------------------------------------------
do_up() {
    ensure_hw || { echo "ERROR no-wifi-hardware"; return 1; }
    regen_conf
    [ -s "$CONF" ] || { log "up: no saved networks"; return 0; }
    start_supplicant || { log "up: supplicant failed"; echo "ERROR supplicant-failed"; return 1; }
    # The supplicant is up and scanning on its own; release the lock so the UI
    # can scan while association/DHCP finish (a 12 s hold made every scan wait).
    flock -u 9
    start=$(now_s)
    end=$((start + 12))
    while [ "$(now_s)" -lt "$end" ]; do
        [ "$(state)" = COMPLETED ] && { lease; break; }
        sleep 1
    done
    log "up: finished state=$(state) ip=$(link_ip) waited=$(( $(now_s) - start ))s"
    echo OK
}

do_down() {
    log "down: begin state=$(state) ip=$(link_ip)"
    stop_supplicant
    log "down: finished iface=$(iface)"
    echo OK
}

do_status() {
    enc=$(iface)
    echo "iface=$enc"
    if [ -z "$enc" ]; then
        echo "state=NOHW"
        echo "ssid="
        echo "ip="
        return 0
    fi
    st=$(state)
    echo "state=${st:-INACTIVE}"
    echo "ssid=$(link_ssid)"
    echo "ip=$(link_ip)"
}

do_scan() {
    ensure_hw || { echo "ERROR no-wifi-hardware"; return 1; }
    enc=$(iface)
    log "scan: begin iface=$enc state=$(state)"
    if [ "$(state)" = "" ]; then
        # first scan ever: no saved networks means no conf file yet, and
        # start_supplicant writes the (empty) conf so the supplicant comes up
        # and can actually scan.
        start_supplicant
        [ "$(state)" = "" ] && {
            log "scan: supplicant failed"
            diag_snapshot
            echo "ERROR supplicant-failed"
            return 1
        }
    fi
    scans_ok=0
    trig=0
    r=$(w scan)
    trig=1
    case "$r" in
    ''|FAIL*) log "scan: trigger#1 failed rc=$r" ;;
    *) scans_ok=1; log "scan: trigger#1 ok" ;;
    esac
    # wpa_cli scan returns at once, and scan_results answers with the header
    # line even while the BSS table is still empty, so "output changed" was
    # true after the first 0.5 s sample and the first-ever scan returned an
    # empty list. Wait for an actual BSS entry (line 2) instead, retrigger the
    # scan every 4 s in case the trigger hit a busy interface, and give up
    # after 15 s (no networks in range).
    start=$(now_s)
    end=$((start + 15))
    last_trig=$start
    while [ "$(now_s)" -lt "$end" ]; do
        sleep 0.5
        [ -n "$(w scan_results | sed -n '2p')" ] && break
        if [ $(( $(now_s) - last_trig )) -ge 4 ]; then
            r=$(w scan)
            trig=$((trig + 1))
            last_trig=$(now_s)
            case "$r" in
            ''|FAIL*) log "scan: trigger#$trig failed rc=$r" ;;
            *) scans_ok=1; log "scan: trigger#$trig ok" ;;
            esac
        fi
    done
    bss=$(w scan_results | sed '1d' | grep -c . 2>/dev/null)
    log "scan: done iface=$enc state=$(state) bss=$bss triggers=$trig scans_ok=$scans_ok waited=$(( $(now_s) - start ))s"
    if [ -z "$(w scan_results | sed -n '2p')" ] && [ "$scans_ok" = 0 ]; then
        log "scan: never triggered on $enc"
        diag_snapshot
        echo "ERROR scan-failed"
        return 1
    fi
    if [ "$bss" = 0 ]; then
        log "scan: zero BSS in range; dumping hardware state"
        diag_snapshot
    fi
    w scan_results | awk -F'\t' '
        NR == 1 { next }                       # header
        $5 == "" { next }                      # hidden SSID
        {
            sec = ($4 ~ /WPA|RSN|WEP/) ? 1 : 0
            gsub(/^ +| +$/, "", $5)
            k = $5
            if (!(k in seen) || $3 + 0 > sig[k]) {
                seen[k] = 1; sig[k] = $3 + 0; secs[k] = sec
            }
        }
        END {
            for (k in seen) printf "%s\t%d\t%s\n", sig[k], secs[k], k
        }' | sort -t'	' -k1,1nr
}

read_arg() { sed -n '1p' "$ARG" 2>/dev/null; }
read_psk_arg() { sed -n '2p' "$ARG" 2>/dev/null; }

do_connect() {
    ssid=$(read_arg)
    psk=$(read_psk_arg)
    [ -n "$ssid" ] || { log "connect: no SSID"; echo "ERROR no-ssid"; return 1; }
    ensure_hw || { echo "ERROR no-wifi-hardware"; return 1; }
    enc=$(iface)

    # an empty passphrase means "use the saved one" (reconnect from the list)
    if [ -z "$psk" ] && [ -n "$(saved_psk "$ssid")" ]; then
        psk=$(saved_psk "$ssid")
    fi
    # Keep what is on disk so a failed attempt can restore it. Saving the
    # attempt unconditionally is what used to leave a secured network marked
    # as "saved" with an empty key, after which the UI never asked for the
    # password again and connecting silently failed.
    had_net=0
    old_psk=""
    if [ -f "$(net_file "$ssid")" ]; then
        had_net=1
        old_psk=$(saved_psk "$ssid")
    fi
    log "connect: ssid=\"$ssid\" psk=$( [ -n "$psk" ] && echo provided || echo none ) iface=$enc state=$(state)"
    save_net "$ssid" "$psk"
    regen_conf "$ssid"

    if supplicant_running; then
        cur=$(link_ssid)
        [ -n "$cur" ] && [ "$cur" != "$ssid" ] && w disconnect >/dev/null 2>&1
        w reconfigure >/dev/null 2>&1
        log "connect: reconfigured supplicant pid=$(supplicant_pid)"
    else
        start_supplicant || { log "connect: supplicant failed"; echo "ERROR supplicant-failed"; return 1; }
    fi

    start=$(now_s)
    end=$((start + 30))
    last_st=""
    while [ "$(now_s)" -lt "$end" ]; do
        st=$(state)
        [ "$st" != "$last_st" ] && { log "connect: state=$st t=$(( $(now_s) - start ))s"; last_st="$st"; }
        [ "$st" = COMPLETED ] && break
        sleep 1
    done
    st=$(state)
    log "connect: association finished state=$st t=$(( $(now_s) - start ))s ip=$(link_ip)"
    if [ "$st" != COMPLETED ]; then
        diag_snapshot
        if [ "$had_net" = 1 ]; then
            save_net "$ssid" "$old_psk"
        else
            drop_net "$ssid"
        fi
        regen_conf
        echo "ERROR association-failed ($st)"
        return 1
    fi
    lease
    i=0
    while [ $i -lt 15 ]; do
        ip=$(link_ip)
        [ -n "$ip" ] && {
            log "connect: ok ssid=\"$ssid\" ip=$ip waited=${i}s"
            echo "OK $ip"
            return 0
        }
        sleep 1
        i=$((i + 1))
    done
    log "connect: no DHCP lease state=$(state) iface=$enc"
    diag_snapshot
    echo "ERROR no-dhcp-lease"
    return 1
}

# --- connectivity test -----------------------------------------------------
# curl's own --connect-timeout/--max-time are the watchdog. DNS is inferred
# from curl exit 6 (could not resolve host) instead of a separate nslookup,
# which cannot be time-limited here.
# Three endpoints, first success wins: the first two are reachable from CN
# without a proxy, the last one also proves TLS + the CA bundle work.
probe() { # $1 url -> P_CODE (http status), P_RC (curl exit)
    P_CODE=$(curl -s -o /dev/null -w '%{http_code}' \
        --connect-timeout 4 --max-time 6 --cacert "$CA" "$1" 2>/dev/null)
    P_RC=$?
}

do_test() {
    enc=$(iface)
    [ -n "$enc" ] || { echo "ERROR no-wifi-hardware"; return 1; }

    if [ "$(state)" != COMPLETED ]; then
        log "test: link=fail state=$(state) iface=$enc"
        echo "link=fail"
        echo "route=wait"
        echo "dns=wait"
        echo "net=wait"
        echo "ERROR link"
        return 1
    fi
    log "test: link=ok ssid=\"$(link_ssid)\" ip=$(link_ip) iface=$enc"
    echo "link=ok"
    echo "ssid=$(link_ssid)"
    echo "ip=$(link_ip)"

    if ip -4 route 2>/dev/null | grep -q '^default'; then
        log "test: route=ok"
        echo "route=ok"
    else
        log "test: route=fail"
        echo "route=fail"
        echo "dns=wait"
        echo "net=wait"
        echo "ERROR route"
        return 1
    fi

    resolved=0
    reached=0
    for u in http://connect.rom.miui.com/generate_204 \
             http://www.msftconnecttest.com/connecttest.txt \
             https://github.com; do
        probe "$u"
        log "test: probe $u http=$P_CODE curl_rc=$P_RC"
        [ $P_RC -ne 6 ] && resolved=1
        case $u in
        *generate_204) want=204 ;;
        *)             want=200 ;;
        esac
        if [ "$P_CODE" = "$want" ]; then reached=1; break; fi
    done

    if [ $resolved -eq 1 ]; then echo "dns=ok"; else echo "dns=fail"; fi
    if [ $reached -eq 1 ]; then
        log "test: net=ok resolved=$resolved"
        echo "net=ok"
        echo OK
        return 0
    fi
    log "test: net=fail resolved=$resolved"
    echo "net=fail"
    if [ $resolved -eq 1 ]; then echo "ERROR net"; else echo "ERROR dns"; fi
    return 1
}

do_disconnect() {
    log "disconnect: begin state=$(state) ssid=\"$(link_ssid)\""
    w disconnect >/dev/null 2>&1
    kill_lease
    log "disconnect: done state=$(state)"
    echo OK
}

do_forget() {
    ssid=$(read_arg)
    [ -n "$ssid" ] || { log "forget: no SSID"; echo "ERROR no-ssid"; return 1; }
    log "forget: ssid=\"$ssid\" connected=$(link_ssid)"
    drop_net "$ssid"
    regen_conf
    if supplicant_running; then
        w reconfigure >/dev/null 2>&1
        [ "$(link_ssid)" = "$ssid" ] && w disconnect >/dev/null 2>&1
    fi
    log "forget: done"
    echo OK
}

do_known() {
    # SSID <tab> 1 when a passphrase is stored, 0 when it is an open network.
    # The UI needs this to know whether a "saved" secured network can actually
    # connect without asking for the key again.
    known_nets | while IFS= read -r ssid; do
        [ -n "$ssid" ] || continue
        if [ -n "$(saved_psk "$ssid")" ]; then
            printf '%s\t1\n' "$ssid"
        else
            printf '%s\t0\n' "$ssid"
        fi
    done
}

case ${1:-status} in
up)         do_up ;;
down)       do_down ;;
status)     do_status ;;
scan)       do_scan ;;
connect)    do_connect ;;
test)       do_test ;;
disconnect) do_disconnect ;;
forget)     do_forget ;;
known)      do_known ;;
*)          echo "Usage: $0 {up|down|status|scan|connect|test|disconnect|forget|known}"; exit 1 ;;
esac
