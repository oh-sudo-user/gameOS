#!/bin/sh
# gameOS OTA: fetch a release manifest, download the rootfs + boot assets and
# write them into the slot that is NOT running. U-Boot's boot.scr then boots
# that slot on the next start and falls back to the previous confirmed slot
# after four unconfirmed boots (see board/gameos/rgds-plus/boot.cmd).
#
#   gameos-update check      compare the release manifest with /etc/gameos-version
#   gameos-update apply      download, verify, write the idle slot, then ready
#   gameos-update autocheck  check only when a network link is up (boot time)
#   gameos-update status     print the current state file
#
# The UI polls /run/gameos/update-state (key=value: state, version, pct, msg)
# and runs the commands above in the background. Release artifacts come from
# the GitHub "latest release" alias, so no API token or rate limit is involved:
#   https://github.com/<repo>/releases/latest/download/<asset>
#
# Integrity model: the manifest is generated by post-image.sh in a fixed
# one-line-per-section format and is parsed here with a STRICT anchored parser
# (exact key set, no duplicates, value type/range/whitelist checks). The rootfs
# is gzip-tested, decompressed to a temp file and length-checked BEFORE any
# block write; the boot tar is member-whitelisted and staged before install.
# The boot state (slot switch) is written LAST, only after every asset is
# written, verified and synced. HTTPS + same-origin SHA256 detects corruption
# but is NOT publisher authentication; manifest signing is a separate task.

REPO=oh-sudo-user/gameOS
BASE="https://github.com/$REPO/releases/latest/download"
APPDIR=/userdata/system/update
RUN=/run/gameos
STATE=$RUN/update-state
OUT=$RUN/update-op.out
RC=$RUN/update-op.rc
MANIFEST=$APPDIR/manifest.json
ROOTFS=$APPDIR/rootfs.ext4.gz
BOOT=$APPDIR/boot.tar.gz
RAW_TMP=$APPDIR/rootfs.ext4.tmp
STAGE=$RUN/boot-staging
CACERT=/etc/ssl/certs/ca-certificates.crt

# Hard upper bounds (bytes): rootfs raw <= 1200 MiB slot, gz <= 600 MiB,
# boot tar <= 64 MiB. Anything larger is rejected before download/write.
MAX_ROOTFS=1258291200
MAX_ROOTFS_GZ=629145600
MAX_BOOT=67108864
MAX_BOOTFILE=67108864
MAX_BOOTSCR=65536

mkdir -p "$RUN" "$APPDIR"
case $1 in
check|apply|autocheck)
    exec 9>"$RUN/update.lock"; flock 9
    echo $$ > "$RUN/update.pid"
    # The lock guarantees no other updater is running, so a temp file or
    # staging dir left by a crashed run is stale and safe to remove.
    rm -f "$RAW_TMP"
    rm -rf "$STAGE"
    ;;
esac

state() {  # state <key> <value> ... (file rewritten atomically)
    printf '%s\n' "$@" > "$STATE.new" && mv -f "$STATE.new" "$STATE"
}
online() { ip -4 route 2>/dev/null | grep -q '^default '; }
current_slot() {
    s=$(sed -n 's/.*root=PARTLABEL=GAMEOS-ROOT-\([AB]\).*/\1/p' /proc/cmdline | head -n 1)
    echo "$(echo "${s:-A}" | tr 'AB' 'ab')"
}
device_model() {
    compat=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null)
    case "$compat" in
        *rg-ds-plus*) echo rgds-plus ;;
        *rg-ds*)      echo rgds ;;
        *)            echo unknown ;;
    esac
}
part_dev() {  # part_dev GAMEOS-ROOT-B -> /dev/... or nothing
    p=$(readlink -f "/dev/disk/by-partlabel/$1" 2>/dev/null)
    [ -b "$p" ] && { echo "$p"; return 0; }
    root=$(awk '$2 == "/" { print $1; exit }' /proc/self/mounts)
    disk=${root%p[0-9]*}
    [ -b "$disk" ] || return 1
    nr=$(partx -s -o NR,NAME "$disk" 2>/dev/null | awk -v n="$1" '$2 == n { print $1; exit }')
    [ -n "$nr" ] && echo "${disk}p$nr"
}

# ver_cmp <release> <current> -> 1 newer, 0 same, -1 older. Compares numeric
# major.minor.patch and ignores the "+g<sha>" build suffix, so a rebuild of the
# same release is never offered as an update and an older release is not
# either. An unknown/empty current version counts as 0.0.0.
ver_cmp() {
    a=$(echo "$1" | sed 's/+.*$//')
    b=$(echo "$2" | sed 's/+.*$//')
    i=1
    while [ $i -le 3 ]; do
        x=$(echo "$a" | cut -d. -f$i)
        y=$(echo "$b" | cut -d. -f$i)
        case "$x" in ''|*[!0-9]*) x=0 ;; esac
        case "$y" in ''|*[!0-9]*) y=0 ;; esac
        [ "$x" -gt "$y" ] && { echo 1; return 0; }
        [ "$x" -lt "$y" ] && { echo -1; return 0; }
        i=$((i + 1))
    done
    echo 0
}

# --- strict manifest validation ---------------------------------------------
# Sets RELVER rfile rsha rsize rgz bfile bsha bsize on success; returns 1 on
# any deviation. The manifest is machine-generated (post-image.sh) with one
# line per section; each section line is extracted anchored to line start,
# required to be unique, value-checked, then re-serialised and compared to the
# canonical form so extra/duplicate/reordered keys or whitespace tricks fail.
is_hex64() {
    [ "${#1}" = 64 ] || return 1
    case "$1" in *[!0-9a-f]*) return 1 ;; esac
    return 0
}
is_uint() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    return 0
}
validate_manifest() {
    [ -f "$MANIFEST" ] || return 1
    # Reject CR (generator emits LF only); a CR would corrupt sed extraction.
    cr=$(printf '\r')
    case "$(cat "$MANIFEST")" in *"$cr"*) return 1 ;; esac

    # version: exactly one anchored line, N.N.N with optional +g<hex> suffix.
    [ "$(sed -n '/^[[:space:]]*"version"[[:space:]]*:/p' "$MANIFEST" | grep -c .)" = 1 ] || return 1
    RELVER=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" | head -n 1)
    vbase=${RELVER%%+*}
    case "$vbase" in *[!0-9.]*) return 1 ;; esac
    [ "$(printf '%s' "$vbase" | tr -cd '.' | wc -c | tr -d ' ')" = 2 ] || return 1
    for c in $(echo "$vbase" | cut -d. -f1) $(echo "$vbase" | cut -d. -f2) $(echo "$vbase" | cut -d. -f3); do
        is_uint "$c" || return 1
    done
    # Optional build suffix is "+g<short git sha>" (hex, not the 64-char file hash).
    case "$RELVER" in
        *+g*) suf=${RELVER#*+g}
              case "$suf" in ''|*[!0-9a-f]*) return 1 ;; esac
              [ "${#suf}" -le 40 ] || return 1 ;;
        *+*)  return 1 ;;
    esac

    # rootfs section
    [ "$(sed -n '/^[[:space:]]*"rootfs"[[:space:]]*:[[:space:]]*{/p' "$MANIFEST" | grep -c .)" = 1 ] || return 1
    rsec=$(sed -n '/^[[:space:]]*"rootfs"[[:space:]]*:[[:space:]]*{/p' "$MANIFEST")
    rfile=$(printf '%s\n' "$rsec" | sed -n 's/.*"file"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    rsha=$(printf '%s\n' "$rsec" | sed -n 's/.*"sha256"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    rsize=$(printf '%s\n' "$rsec" | sed -n 's/.*"size"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
    rgz=$(printf '%s\n' "$rsec" | sed -n 's/.*"gz"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
    [ "$rfile" = "gameOS-rootfs.ext4.gz" ] || return 1
    is_hex64 "$rsha" || return 1
    is_uint "$rsize" && is_uint "$rgz" || return 1
    [ "$rsize" -gt 0 ] && [ "$rsize" -le "$MAX_ROOTFS" ] || return 1
    [ "$rgz" -gt 0 ] && [ "$rgz" -le "$MAX_ROOTFS_GZ" ] || return 1
    rnorm=$(printf '%s' "$rsec" | tr -d ' \t')
    rexp=$(printf '"rootfs":{"file":"%s","sha256":"%s","size":%s,"gz":%s},' "$rfile" "$rsha" "$rsize" "$rgz")
    [ "$rnorm" = "$rexp" ] || return 1

    # boot section
    [ "$(sed -n '/^[[:space:]]*"boot"[[:space:]]*:[[:space:]]*{/p' "$MANIFEST" | grep -c .)" = 1 ] || return 1
    bsec=$(sed -n '/^[[:space:]]*"boot"[[:space:]]*:[[:space:]]*{/p' "$MANIFEST")
    bfile=$(printf '%s\n' "$bsec" | sed -n 's/.*"file"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    bsha=$(printf '%s\n' "$bsec" | sed -n 's/.*"sha256"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    bsize=$(printf '%s\n' "$bsec" | sed -n 's/.*"size"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
    [ "$bfile" = "gameOS-boot.tar.gz" ] || return 1
    is_hex64 "$bsha" || return 1
    is_uint "$bsize" || return 1
    [ "$bsize" -gt 0 ] && [ "$bsize" -le "$MAX_BOOT" ] || return 1
    bnorm=$(printf '%s' "$bsec" | tr -d ' \t')
    bexp=$(printf '"boot":{"file":"%s","sha256":"%s","size":%s},' "$bfile" "$bsha" "$bsize")
    [ "$bnorm" = "$bexp" ] || return 1
    return 0
}

fetch() {  # fetch <url> <file> <expected-size> <label> ; progress to update-state
    rm -f "$2.part"
    curl -fsSL --retry 2 --retry-delay 2 --connect-timeout 20 \
        --cacert "$CACERT" -o "$2.part" "$1" 9>&- &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        # busybox has no stat(1); wc -c is the portable size query here.
        cur=$(wc -c < "$2.part" 2>/dev/null)
        case "$cur" in ''|*[!0-9]*) cur=0 ;; esac
        pct=0
        [ "$3" -gt 0 ] 2>/dev/null && pct=$((cur * 100 / $3))
        [ $pct -gt 99 ] && pct=99
        state "state=downloading" "pct=$pct" "version=$RELVER" "msg=$4"
        sleep 1
    done
    wait "$pid" || { rm -f "$2.part"; return 1; }
    mv -f "$2.part" "$2"
}

do_check() {
    state "state=checking" "pct=0" "version=" "msg="
    if ! online; then
        state "state=nowifi" "pct=0" "version=" "msg=no network"
        return 1
    fi
    rm -f "$MANIFEST.part"
    if ! curl -fsSL --retry 2 --connect-timeout 20 --cacert "$CACERT" \
            -o "$MANIFEST.part" "$BASE/manifest.json" 9>&-; then
        rm -f "$MANIFEST.part"
        state "state=failed" "pct=0" "version=" "msg=manifest download failed"
        return 1
    fi
    mv -f "$MANIFEST.part" "$MANIFEST"
    if ! validate_manifest; then
        state "state=failed" "pct=0" "version=" "msg=bad manifest"
        return 1
    fi
    CUR=$(cat /etc/gameos-version 2>/dev/null)
    if [ "$(ver_cmp "$RELVER" "$CUR")" = 1 ]; then
        state "state=available" "pct=0" "version=$RELVER" "msg=current $CUR"
    else
        state "state=uptodate" "pct=0" "version=$RELVER" "msg="
    fi
    return 0
}

do_apply() {
    [ -f "$MANIFEST" ] || do_check || return 1
    if ! validate_manifest; then
        state "state=failed" "version=" "msg=bad manifest"; return 1
    fi
    CUR=$(cat /etc/gameos-version 2>/dev/null)
    # only ever install something NEWER than what is running
    [ "$(ver_cmp "$RELVER" "$CUR")" = 1 ] || {
        state "state=uptodate" "pct=0" "version=$RELVER" "msg="; return 0; }

    online || { state "state=nowifi" "version=$RELVER" "msg=no network"; return 1; }
    mountpoint -q /userdata || { state "state=failed" "version=$RELVER" "msg=no data partition"; return 1; }
    model=$(device_model)
    [ "$model" != unknown ] || { state "state=failed" "version=$RELVER" "msg=unknown device model"; return 1; }

    slot=$(current_slot)
    [ "$slot" = a ] && target=b || target=a
    part=$(part_dev "GAMEOS-ROOT-$(echo "$target" | tr ab AB)")
    if [ -z "$part" ]; then
        state "state=failed" "version=$RELVER" "msg=no idle slot"; return 1
    fi
    case $(awk -v p="$part" '$1 == p { print "mounted" }' /proc/self/mounts) in
    mounted) state "state=failed" "version=$RELVER" "msg=slot in use"; return 1 ;;
    esac
    # busybox has no blockdev; fall back to the sysfs sector count (512B units).
    psize=$(blockdev --getsize64 "$part" 2>/dev/null || echo 0)
    if [ "$psize" = 0 ] 2>/dev/null; then
        secs=$(cat "/sys/class/block/${part##*/}/size" 2>/dev/null)
        case "$secs" in ''|*[!0-9]*) secs=0 ;; esac
        psize=$((secs * 512))
    fi
    if [ "$psize" -lt "$rsize" ] 2>/dev/null; then
        state "state=failed" "version=$RELVER" "msg=slot too small"; return 1
    fi

    # 1. download + verify the compressed rootfs, then gzip integrity test.
    fetch "$BASE/$rfile" "$ROOTFS" "$rgz" "rootfs" || {
        state "state=failed" "version=$RELVER" "msg=rootfs download failed"; return 1; }
    state "state=downloading" "pct=100" "version=$RELVER" "msg=verify"
    got=$(sha256sum "$ROOTFS" | cut -d' ' -f1)
    if [ "$got" != "$rsha" ]; then
        rm -f "$ROOTFS"
        state "state=failed" "version=$RELVER" "msg=rootfs checksum mismatch"; return 1
    fi
    if ! gzip -t "$ROOTFS" 9>&-; then
        rm -f "$ROOTFS"
        state "state=failed" "version=$RELVER" "msg=rootfs gzip integrity check failed"; return 1
    fi

    # 2. download + verify the boot tar, whitelist members, stage and inspect.
    fetch "$BASE/$bfile" "$BOOT" "$bsize" "boot" || {
        rm -f "$ROOTFS"
        state "state=failed" "version=$RELVER" "msg=boot download failed"; return 1; }
    got=$(sha256sum "$BOOT" | cut -d' ' -f1)
    if [ "$got" != "$bsha" ]; then
        rm -f "$ROOTFS" "$BOOT"
        state "state=failed" "version=$RELVER" "msg=boot checksum mismatch"; return 1
    fi
    if ! tar -tzf "$BOOT" > "$RUN/boot-members.txt" 9>&-; then
        rm -f "$ROOTFS" "$BOOT"
        state "state=failed" "version=$RELVER" "msg=invalid boot archive"; return 1
    fi
    # Exactly the five whitelisted members, each present once, nothing else
    # (no absolute paths, no ../, no directories, no extra files).
    [ "$(grep -c . "$RUN/boot-members.txt")" = 5 ] || {
        rm -f "$ROOTFS" "$BOOT"
        state "state=failed" "version=$RELVER" "msg=boot archive members not allowed"; return 1; }
    for m in Image rk3568-anbernic-rg-ds-plus.dtb rk3568-anbernic-rg-ds.dtb boot.scr.rgds-plus boot.scr.rgds; do
        grep -qx "$m" "$RUN/boot-members.txt" || {
            rm -f "$ROOTFS" "$BOOT"
            state "state=failed" "version=$RELVER" "msg=boot archive missing $m"; return 1; }
    done
    while IFS= read -r m; do
        case "$m" in
            Image|rk3568-anbernic-rg-ds-plus.dtb|rk3568-anbernic-rg-ds.dtb|boot.scr.rgds-plus|boot.scr.rgds) ;;
            *) rm -f "$ROOTFS" "$BOOT"
               state "state=failed" "version=$RELVER" "msg=boot archive bad member"; return 1 ;;
        esac
    done < "$RUN/boot-members.txt"
    rm -rf "$STAGE"; mkdir -p "$STAGE"
    if ! tar -xzf "$BOOT" -C "$STAGE" 9>&-; then
        rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=boot extract failed"; return 1
    fi
    # Every staged member must be a regular, non-empty, size-bounded file
    # (rejects symlinks, device nodes and directories smuggled past the name
    # whitelist). An old release's boot tar lacks boot.scr.* and fails above.
    for m in Image rk3568-anbernic-rg-ds-plus.dtb rk3568-anbernic-rg-ds.dtb boot.scr.rgds-plus boot.scr.rgds; do
        f="$STAGE/$m"
        if [ ! -f "$f" ] || [ -L "$f" ]; then
            rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
            state "state=failed" "version=$RELVER" "msg=boot member not a regular file"; return 1
        fi
        sz=$(wc -c < "$f" | tr -d ' ')
        is_uint "$sz" || { rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
            state "state=failed" "version=$RELVER" "msg=boot member size unreadable"; return 1; }
        cap=$MAX_BOOTFILE
        case "$m" in boot.scr.*) cap=$MAX_BOOTSCR ;; esac
        if [ "$sz" -le 0 ] || [ "$sz" -gt "$cap" ]; then
            rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
            state "state=failed" "version=$RELVER" "msg=boot member size out of range"; return 1
        fi
    done

    # 3. space gate, then decompress to a temp file and length-check BEFORE
    #    touching the block device (no pipe-status ambiguity, no pipefail).
    avail_kb=$(df -Pk "$APPDIR" | awk 'NR == 2 { print $4 }')
    case "$avail_kb" in ''|*[!0-9]*) avail_kb=0 ;; esac
    need_kb=$(((rsize + 65535) / 1024 + 65536))
    if [ "$avail_kb" -lt "$need_kb" ]; then
        rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=not enough space to verify rootfs"; return 1
    fi
    state "state=installing" "pct=0" "version=$RELVER" "msg=rootfs to slot $target"
    rm -f "$RAW_TMP"
    if ! gzip -dc "$ROOTFS" > "$RAW_TMP" 9>&-; then
        rm -f "$RAW_TMP" "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=rootfs decompression failed"; return 1
    fi
    raw_actual=$(wc -c < "$RAW_TMP" | tr -d ' ')
    is_uint "$raw_actual" || raw_actual=0
    if [ "$raw_actual" != "$rsize" ]; then
        rm -f "$RAW_TMP" "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=rootfs uncompressed size mismatch"; return 1
    fi
    if ! dd if="$RAW_TMP" of="$part" bs=4M conv=fsync 9>&-; then
        rm -f "$RAW_TMP" "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=rootfs block write failed"; return 1
    fi
    sync
    rm -f "$RAW_TMP"

    # 4. install boot assets into the idle slot, then the model's boot.scr.
    mountpoint -q /boot || mount "${part%p[0-9]}p1" /boot 2>/dev/null
    if ! mountpoint -q /boot; then
        rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=no boot partition"; return 1
    fi
    state "state=installing" "pct=100" "version=$RELVER" "msg=kernel to slot $target"
    mkdir -p "/boot/$target"
    for m in Image rk3568-anbernic-rg-ds-plus.dtb rk3568-anbernic-rg-ds.dtb; do
        cp "$STAGE/$m" "/boot/$target/$m.new" || {
            rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
            state "state=failed" "version=$RELVER" "msg=boot asset install failed"; return 1; }
        sync
        mv -f "/boot/$target/$m.new" "/boot/$target/$m" || {
            rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
            state "state=failed" "version=$RELVER" "msg=boot asset activate failed"; return 1; }
    done
    cp "$STAGE/boot.scr.$model" /boot/boot.scr.new || {
        rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=boot script install failed"; return 1; }
    sync
    mv -f /boot/boot.scr.new /boot/boot.scr || {
        rm -f "$ROOTFS" "$BOOT"; rm -rf "$STAGE"
        state "state=failed" "version=$RELVER" "msg=boot script activate failed"; return 1; }
    sync
    rm -rf "$STAGE"

    # 5. LAST: switch the boot state. fallback = the slot running right now
    #    (the last confirmed-good one), so a failed new slot rolls back to it.
    printf 'slot=%s\nfallback=%s\nn=0\n' "$target" "$slot" > /boot/state.new || {
        rm -f "$ROOTFS" "$BOOT"
        state "state=failed" "version=$RELVER" "msg=write boot state failed"; return 1; }
    sync
    mv -f /boot/state.new /boot/state || {
        rm -f "$ROOTFS" "$BOOT"
        state "state=failed" "version=$RELVER" "msg=activate boot state failed"; return 1; }
    sync
    rm -f "$ROOTFS" "$BOOT"
    state "state=ready" "pct=100" "version=$RELVER" "msg=slot $target"
    return 0
}

case $1 in
check)      do_check >"$OUT" 2>&1 ;;
apply)      do_apply >"$OUT" 2>&1 ;;
autocheck)
    online || exit 0
    do_check >"$OUT" 2>&1
    ;;
status)     cat "$STATE" 2>/dev/null ;;
*)          echo "usage: gameos-update check|apply|autocheck|status" >&2; exit 1 ;;
esac
rc=$?
echo "$rc" > "$RC"
exit "$rc"