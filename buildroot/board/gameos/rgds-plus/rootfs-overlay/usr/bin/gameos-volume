#!/bin/sh
# gameos-volume — the one volume path for keys, UI and scripts.
#
#   gameos-volume up|down       step by 5, print the new level
#   gameos-volume set <0-100>   absolute level
#   gameos-volume get           print the last level
#
# Card indices swap between boots (rk817 jack / aw88166 speakers), so the mixer
# controls are probed once and cached in /run/gameos/volume.map; after that a
# change is 2-4 amixer calls instead of walking every card and control. The
# hardware keys fork a helper per press, so the lock makes the level file and
# the mixer changes strictly ordered: without it several slow applies wrote
# volume.level out of order and the UI slider bounced while a key was held.
STATE=/run/gameos/volume.level
MAP=/run/gameos/volume.map
mkdir -p /run/gameos 2>/dev/null

exec 9>/run/gameos/volume.lock
flock 9

current()
{
    v=$(cat "$STATE" 2>/dev/null)
    case "$v" in
        ''|*[!0-9]*) v=70 ;;
    esac
    [ "$v" -gt 100 ] && v=100
    echo "$v"
}

build_map()
{
    : > "$MAP.tmp"
    for carddir in /proc/asound/card[0-9]*; do
        [ -d "$carddir" ] || continue
        card=${carddir##*card}
        for ctl in 'Master' 'Master Playback Volume' 'PCM' 'Left PCM' 'Right PCM' \
                   'Playback Volume' 'DAC Playback Volume' 'Headphone Playback Volume' \
                   'Speaker Playback Volume' 'Digital Volume'; do
            caps=$(amixer -c "$card" sget "$ctl" 2>/dev/null) || continue
            case "$caps" in *Playback*) ;; *) continue ;; esac
            inv=0
            case "$ctl" in
                'Left PCM'|'Right PCM') inv=1 ;;
            esac
            printf '%s\t%s\t%s\n' "$card" "$ctl" "$inv" >> "$MAP.tmp"
        done
    done
    mv -f "$MAP.tmp" "$MAP"
}

apply_map()
{
    ok=0
    tab=$(printf '\t')
    while IFS="$tab" read -r card ctl inv; do
        [ -n "$card" ] || continue
        raw=$pct
        [ "$inv" = 1 ] && raw=$((100 - pct))
        amixer -c "$card" sset "$ctl" "${raw}%" >/dev/null 2>&1 || continue
        ok=$((ok + 1))
        [ "$pct" -gt 0 ] && amixer -c "$card" sset "$ctl" unmute >/dev/null 2>&1
    done < "$MAP"
    echo "$ok"
}

apply()
{
    pct=$1
    # Publish the new level before touching ALSA: the UI reads this file every
    # 250 ms, and the lock guarantees the newest press wins.
    printf '%s\n' "$pct" > "$STATE"

    [ -s "$MAP" ] || build_map
    ok=$(apply_map)
    if [ "$ok" -eq 0 ]; then
        # card order changed (module reload): re-probe once
        rm -f "$MAP"
        build_map
        [ -s "$MAP" ] && ok=$(apply_map)
    fi

    # Bluetooth headphones keep their own A2DP volume.
    if [ -f /run/gameos/bt-audio ]; then
        gameos-bt volume "$pct" >/dev/null 2>&1
    fi
    echo "$pct"
}

case "$1" in
    up)
        v=$(current); v=$((v + 5)); [ "$v" -gt 100 ] && v=100
        apply "$v"
        ;;
    down)
        v=$(current); v=$((v - 5)); [ "$v" -lt 0 ] && v=0
        apply "$v"
        ;;
    set)
        v=$2
        case "$v" in ''|*[!0-9]*) echo "gameos-volume: bad level" >&2; exit 1 ;; esac
        [ "$v" -gt 100 ] && v=100
        apply "$v"
        ;;
    get)
        current
        ;;
    *)
        echo "usage: gameos-volume up|down|set <0-100>|get" >&2
        exit 1
        ;;
esac
