# gameOS mandatory kernel options (safety net on top of the ROCKNIX base config)
# The ROCKNIX base config carries a build-system placeholder here; Buildroot
# has no initramfs, so clear it or the kernel build fails in usr/Makefile.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_GPIO_KEYS=y
CONFIG_JOYSTICK_ADC=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_DRM_PANFROST=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_CONFIGFS=y
CONFIG_PM=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y
# cfg80211/mac80211 as modules, NOT built-in: a built-in cfg80211 requests
# regulatory.db during an early initcall, before the rootfs is mounted, and
# the usermode firmware helper then stalls boot ~60s (BananaOS pitfall).
# As modules they load from S25wireless once /lib/firmware is reachable.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# aw88166 speaker amp as a module: built-in it requests aw88166_acf.bin
# during early probe (before rootfs) and stalls boot (BananaOS needed kernel
# patch 0027 for this). As a module it loads post-rootfs via S25wireless.
CONFIG_SND_SOC_AW88166=m