# gameOS U-Boot config fragment (applied on top of quartz64-a-rk3566 defconfig).
# Run boot.scr from the boot partition first: it picks slot A or B and does the
# failed-boot rollback. extlinux.conf stays on the card only as a fallback for
# a damaged script, and always boots slot A.
CONFIG_CMD_SETEXPR=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if fatload mmc 0:1 ${scriptaddr} boot.scr; then source ${scriptaddr}; fi; echo gameOS: boot.scr failed - falling back; bootflow scan -lb"
